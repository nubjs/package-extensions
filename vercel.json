{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node site/build.mjs",
  "outputDirectory": "site/public",
  "installCommand": "echo 'No dependencies required for the site build'",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/guide/:path*",
      "destination": "/#maintainers",
      "permanent": true
    },
    {
      "source": "/about/:path*",
      "destination": "/#contributing",
      "permanent": true
    },
    {
      "source": "/packages/:name+",
      "destination": "/packages/?q=:name",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
